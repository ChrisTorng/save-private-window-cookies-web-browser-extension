{
  "manifest_version": 3,
  "name": "Save private window cookies (Edge MV3 diagnostics)",
  "description": "Save and verify cookies in Edge InPrivate windows; does not restore other site storage.",
  "version": "1.3.3",
  "homepage_url": "https://github.com/ChrisTorng/save-private-window-cookies-web-browser-extension",
  "icons": {
    "16": "icons/icon-16x16.png",
    "32": "icons/icon-32x32.png",
    "48": "icons/icon-48x48.png",
    "64": "icons/icon-64x64.png",
    "96": "icons/icon-96x96.png",
    "128": "icons/icon-128x128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "InPrivate cookies: diagnostics"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
